# Copy this file to .env and fill in values

# MongoDB (Atlas)
ATLASDB_URL=

# Session secret (any long random string)
SECRET=

# Mapbox
MAP_TOKEN=

# Cloudinary
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Razorpay (Test or Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: promote an existing username to admin on startup
# ADMIN_USERNAME=
