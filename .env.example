# Copy this file to .env and fill values.
# NOTE: .env is ignored by git; do NOT commit secrets.

NODE_ENV=development
PORT=8080

# MongoDB
ATLASDB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Session
SECRET=<long-random-session-secret>

# Mapbox
MAP_TOKEN=<mapbox_token>

# Cloudinary
CLOUD_NAME=<cloudinary_cloud_name>
CLOUD_API_KEY=<cloudinary_api_key>
CLOUD_API_SECRET=<cloudinary_api_secret>

# Razorpay
RAZORPAY_KEY_ID=<razorpay_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>

# OTP delivery (Email via SMTP)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=<google_app_password>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_BRAND=StayEase

# OTP delivery (SMS via MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY=5
MSG91_REALTIME=true

# OTP delivery (SMS via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Social Login (Passport)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Optional: promote a user to admin at startup
ADMIN_USERNAME=
