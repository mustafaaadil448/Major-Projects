# Copy this file to .env and fill in values

# MongoDB (Atlas)
ATLASDB_URL=

# Session secret (any long random string)
SECRET=

# Mapbox
MAP_TOKEN=

# Cloudinary
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Razorpay (Test or Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Social Login (Passport)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the callback URL configured in Google Cloud Console
# Example (Render): https://your-service.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Example (Render): https://your-service.onrender.com/auth/facebook/callback
FACEBOOK_CALLBACK_URL=

# Optional: promote an existing username to admin on startup
# ADMIN_USERNAME=

# Environment
# NODE_ENV=production

# Debug (NEVER enable in production)
# When true (and NODE_ENV is not production), API may return debugOtp for local testing.
# SHOW_DEBUG_OTP=false

# OTP Delivery (Email via SMTP)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# OTP_FROM_EMAIL=no-reply@yourdomain.com
# OTP_BRAND=StayEase

# OTP Delivery (Email via Gmail SMTP)
# NOTE: Use a Google App Password (requires 2-Step Verification). Normal Gmail password will FAIL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_google_app_password
# OTP_FROM_EMAIL=yourgmail@gmail.com

# OTP Delivery (SMS via MSG91 - India, DLT required)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_dlt_template_id
# MSG91_OTP_EXPIRY=5
# MSG91_REALTIME=true

# OTP Delivery (SMS via Twilio - optional fallback)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
