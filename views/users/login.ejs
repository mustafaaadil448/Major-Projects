<% layout('layouts/boilerplate') %>
<h1 class="col-12 col-md-6 offset-md-3">Login</h1>
<div class="row mt-3">
    <div class="col-12 col-md-6 offset-md-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username or Email</label>
                <input name="username" id= "username" type="text" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">password</label>
                <input name="password" id= "password" type="password" class="form-control" required />
            </div>
            <button class="btn btn-success">Login</button>
        </form>

        <hr class="my-4" />

        <h5 class="mb-3">Login with Email OTP</h5>
        <div id="otpLoginAlert" class="alert alert-danger d-none" role="alert"></div>
        <div id="otpLoginInfo" class="alert alert-success d-none" role="status"></div>

        <form id="otpLoginForm" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="otpLoginEmail" class="form-label">Email</label>
                <input id="otpLoginEmail" type="email" class="form-control" required />
            </div>

            <div class="d-flex gap-2">
                <button type="button" id="otpSendBtn" class="btn btn-outline-primary">Send OTP</button>
                <button type="button" id="otpResendBtn" class="btn btn-outline-secondary" disabled>Resend</button>
            </div>

            <div id="otpVerifyBlock" class="mt-3 d-none">
                <div class="mb-3">
                    <label for="otpCode" class="form-label">Enter 6-digit OTP</label>
                    <input id="otpCode" inputmode="numeric" maxlength="6" class="form-control" placeholder="123456" />
                </div>
                <button type="button" id="otpVerifyBtn" class="btn btn-primary">Verify & Login</button>
            </div>
        </form>

        <script src="/CSS/js/otpLogin.js" defer></script>
        
        </div>
    </div>