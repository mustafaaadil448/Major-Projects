<% layout('layouts/admin') %>

<div class="admin-grid">
  <div class="admin-card" style="grid-column: span 12;">
    <div class="admin-card__bd">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <div class="admin-section-title">Reviews Moderation</div>
          <div class="admin-muted">Monitor ratings and remove abusive content</div>
        </div>
      </div>

      <form class="row g-2 mt-2" method="GET" action="/admin/reviews">
        <div class="col-12 col-lg-6">
          <input class="form-control" name="q" placeholder="Search comment" value="<%= query.q %>" />
        </div>
        <div class="col-6 col-lg-3">
          <select class="form-select" name="minRating">
            <option value="">Any rating</option>
            <option value="1" <%= query.minRating==='1'?'selected':'' %>>≥ 1</option>
            <option value="2" <%= query.minRating==='2'?'selected':'' %>>≥ 2</option>
            <option value="3" <%= query.minRating==='3'?'selected':'' %>>≥ 3</option>
            <option value="4" <%= query.minRating==='4'?'selected':'' %>>≥ 4</option>
            <option value="5" <%= query.minRating==='5'?'selected':'' %>>5 only</option>
          </select>
        </div>
        <div class="col-6 col-lg-3 d-grid d-lg-flex gap-2">
          <button class="btn btn-dark" type="submit"><i class="fa-solid fa-magnifying-glass me-2"></i>Apply</button>
          <a class="btn btn-outline-secondary" href="/admin/reviews">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-card" style="grid-column: span 12;">
    <div class="admin-card__bd">
      <div class="table-responsive">
        <table class="table admin-table align-middle">
          <thead>
            <tr>
              <th>Review</th>
              <th>Listing</th>
              <th>User</th>
              <th>Rating</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% (reviews || []).forEach(r => { %>
              <tr>
                <td>
                  <div class="fw-semibold" style="max-width: 520px;"><%= r.comment %></div>
                  <div class="admin-muted small"><%= String(r._id).slice(-8) %></div>
                </td>
                <td>
                  <a class="text-decoration-none" href="/<%= r.listingId %>"><%= r.listingTitle %></a>
                </td>
                <td>
                  <div class="fw-semibold"><%= r.author?.username || '—' %></div>
                  <div class="admin-muted small"><%= r.author?.email || '' %></div>
                </td>
                <td>
                  <span class="status-badge" style="background: rgba(17,17,17,0.06);"><%= r.rating %>/5</span>
                </td>
                <td class="admin-muted"><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '—' %></td>
                <td class="text-end">
                  <form method="POST" action="/admin/reviews/<%= r._id %>?_method=DELETE" class="m-0" onsubmit="return confirm('Delete this review?');">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="admin-muted small mt-2">Showing up to 200 results.</div>
    </div>
  </div>
</div>
