<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin StayEase Pvt. Ltd.</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/CSS/admin.css" />

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>

<body class="admin-body">
  <%
    const activeSafe = (typeof active !== 'undefined' && active) ? active : 'dashboard';
    const pageTitleSafe = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Dashboard';
    const pageSubtitleSafe = (typeof pageSubtitle !== 'undefined' && pageSubtitle) ? pageSubtitle : '';
  %>
  <div class="admin-shell" data-active="<%= activeSafe %>">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="admin-sidebar__brand">
        <a href="/admin" class="admin-brand">
          <span class="admin-brand__logo" aria-hidden="true">
            <img class="admin-brand__img" src="/assets/stayease.png" alt="StayEase" />
          </span>
          <span class="admin-brand__text">Admin</span>
        </a>
        <button class="btn btn-sm btn-outline-light admin-sidebar__toggle" type="button" id="sidebarToggle" aria-label="Toggle sidebar">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>

      <nav class="admin-nav">
        <a class="admin-nav__item" href="/admin" data-key="dashboard"><i class="fa-solid fa-grid-2"></i><span>Dashboard</span></a>
        <a class="admin-nav__item" href="/admin/listings" data-key="listings"><i class="fa-regular fa-building"></i><span>Listings</span></a>
        <a class="admin-nav__item" href="/admin/bookings" data-key="bookings"><i class="fa-regular fa-calendar-check"></i><span>Bookings</span></a>
        <a class="admin-nav__item" href="/admin/users" data-key="users"><i class="fa-regular fa-user"></i><span>Users</span></a>
        <a class="admin-nav__item" href="/admin/reviews" data-key="reviews"><i class="fa-regular fa-star"></i><span>Reviews</span></a>
        <a class="admin-nav__item" href="/admin/payments" data-key="payments"><i class="fa-solid fa-indian-rupee-sign"></i><span>Payments</span></a>
        <a class="admin-nav__item" href="/admin/analytics" data-key="analytics"><i class="fa-solid fa-chart-line"></i><span>Analytics</span></a>
        <a class="admin-nav__item" href="/admin/settings" data-key="settings"><i class="fa-solid fa-gear"></i><span>Settings</span></a>
      </nav>

      <div class="admin-sidebar__footer">
        <div class="small text-white-50">Signed in as</div>
        <div class="fw-semibold text-white"><%= currentUser?.username || 'Admin' %></div>
        <a href="/logout" class="btn btn-sm btn-outline-light mt-2 w-100">Log out</a>
      </div>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" id="sidebarToggleMobile" aria-label="Toggle sidebar">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <div class="admin-title"><%= pageTitleSafe %></div>
            <div class="admin-subtitle text-muted"><%= pageSubtitleSafe %></div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-secondary position-relative" type="button" id="notifyBtn" aria-label="Notifications">
            <i class="fa-regular fa-bell"></i>
            <span class="admin-badge" id="notifyBadge" style="display:none"></span>
          </button>

          <button class="btn btn-sm btn-outline-secondary" type="button" id="darkToggle" aria-label="Toggle dark mode">
            <i class="fa-regular fa-moon"></i>
          </button>

          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              <span class="admin-avatar" aria-hidden="true"><%= (currentUser?.username ? String(currentUser.username).charAt(0).toUpperCase() : 'A') %></span>
              <span class="d-none d-sm-inline"><%= currentUser?.username || 'Admin' %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/admin/settings">Settings</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/logout">Log out</a></li>
            </ul>
          </div>
        </div>
      </header>

      <section class="admin-content">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
      </section>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
  <script src="/CSS/js/admin.js"></script>
</body>
</html>
