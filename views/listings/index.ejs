<% layout('layouts/boilerplate') %>

<% if ((typeof q !== 'undefined' && q) && (!allListings || allListings.length === 0)) { %>
    <div class="alert alert-light border mt-3 mb-0">
        No results found for <b><%= q %></b>.
    </div>
<% } %>

<%
    const qVal = (typeof q !== 'undefined' && q) ? String(q) : '';
    const qParam = qVal ? `&q=${encodeURIComponent(qVal)}` : '';
    const activeFilterVal = (typeof activeFilter !== 'undefined' && activeFilter) ? String(activeFilter) : '';
    function filterHref(key) {
        return `/?filter=${encodeURIComponent(key)}${qParam}`;
    }
    function filterClass(key) {
        return activeFilterVal === key ? 'filter is-active' : 'filter';
    }
%>

<div class="filters-bar">
<div id="filters">
    <a class="filter-link" href="<%= filterHref('trending') %>">
    <div class="<%= filterClass('trending') %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('rooms') %>">
    <div class="<%= filterClass('rooms') %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('iconic') %>">
    <div class="<%= filterClass('iconic') %>">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('mountains') %>">
    <div class="<%= filterClass('mountains') %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Mountains</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('castles') %>">
    <div class="<%= filterClass('castles') %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('pools') %>">
    <div class="<%= filterClass('pools') %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('camping') %>">
    <div class="<%= filterClass('camping') %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('farms') %>">
    <div class="<%= filterClass('farms') %>">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('arctic') %>">
    <div class="<%= filterClass('arctic') %>">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('domes') %>">
    <div class="<%= filterClass('domes') %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </div>
    </a>
    <a class="filter-link" href="<%= filterHref('boats') %>">
    <div class="<%= filterClass('boats') %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div>
    </a>
</div>

<div class="tax-toggle">
    <div class="form-check-reverse form-switch m-0">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
</div>
</div>
<div class="mt-3 listing-row">
    <% for(let listing of allListings) { %>
        <a href="/<%= listing._id %>" class="listing-link d-block">
        <div class="card col listing-card">
            <% const imgUrl = listing.image?.url ? listing.image.url.replace("/upload", "/upload/f_auto,q_auto,w_800") : ""; %>
            <img src="<%= imgUrl %>" class="card-img-top" alt="listing_image" />
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b> <br>
                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                    <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                </p>
            </div>
        </div>
        </a>
        <% } %>
</div>

<script>
    let texSwitch = document.getElementById("flexSwitchCheckDefault");
    texSwitch.addEventListener("click", ()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for ( info of taxInfo){
        if(info.style.display != "inline"){
            info.style.display = "inline";
        } else {
            info.style.display = "none";
        }
    }
    });
</script>